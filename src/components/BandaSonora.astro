---
import type { CollectionEntry } from 'astro:content';
import EnlaceExterno from './EnlaceExterno.astro';

interface Props {
  datos: CollectionEntry<'sitio'>['data']['banda_sonora'];
}
const { datos } = Astro.props;
---

<section class="banda" id="banda-sonora" aria-labelledby="banda-sonora-titular">
  <div class="contenedor banda__rejilla">
    <div class="banda__cabeza">
      <p class="etiqueta">{datos.etiqueta}</p>
      <h2 id="banda-sonora-titular">{datos.titular}</h2>
    </div>
    <div class="banda__cuerpo">
      <p>{datos.texto}</p>
      {
        datos.enlace && (
          <EnlaceExterno href={datos.enlace} class="boton boton--contorno">
            {datos.enlace_texto}
          </EnlaceExterno>
        )
      }
    </div>
  </div>
</section>

<style>
  .banda {
    padding-block: clamp(3.5rem, 2rem + 6vw, 6rem);
    border-top: 1px solid var(--linea);
    background: var(--superficie);
  }

  .banda__rejilla {
    display: grid;
    gap: 2rem;
  }

  .banda__cabeza {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .banda h2 {
    font-size: clamp(2rem, 1.4rem + 2.4vw, 2.75rem);
  }

  .banda__cuerpo {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    max-width: var(--lectura);
    color: var(--texto-suave);
  }

  @media (min-width: 60rem) {
    .banda__rejilla {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(3rem, 7vw, 6rem);
      align-items: center;
    }
  }
</style>
