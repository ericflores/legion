---
import type { CollectionEntry } from 'astro:content';
import EnlaceExterno from './EnlaceExterno.astro';
import Seccion from './Seccion.astro';

interface Props {
  datos: CollectionEntry<'sitio'>['data']['banda_sonora'];
}
const { datos } = Astro.props;
---

<Seccion id="banda-sonora" etiqueta={datos.etiqueta} titular={datos.titular}>
  <div class="banda">
    <p>{datos.texto}</p>
    {
      datos.enlace && (
        <EnlaceExterno href={datos.enlace} class="boton boton--contorno">
          {datos.enlace_texto}
        </EnlaceExterno>
      )
    }
  </div>
</Seccion>

<style>
  .banda {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    max-width: var(--lectura);
    color: var(--texto-suave);
  }
</style>
