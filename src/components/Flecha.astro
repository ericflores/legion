---
// Flecha decorativa. "fuera" = el enlace sale del sitio; "abajo" y "diagonal" = baja en la página.
interface Props {
  tipo?: 'fuera' | 'abajo' | 'diagonal' | 'derecha';
}
const { tipo = 'derecha' } = Astro.props;
const trazos = {
  fuera: 'M7 17 17 7M9 7h8v8',
  abajo: 'M12 5v14M6 13l6 6 6-6',
  diagonal: 'M7 7l10 10M9 17h8V9',
  derecha: 'M5 12h14M13 6l6 6-6 6',
};
---

<svg
  class="flecha"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  <path d={trazos[tipo]}></path>
</svg>
