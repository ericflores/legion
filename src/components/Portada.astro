---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { imagen } from '../lib/imagenes';
import { seccion } from '../lib/sitio';
import Flecha from './Flecha.astro';

interface Props {
  sitio: CollectionEntry<'sitio'>['data'];
}
const { sitio } = Astro.props;
const portada = imagen(sitio.portada);
// Tamaños a servir: nunca más anchos que la imagen original.
const anchos = portada ? [...[360, 540, 720, 1080].filter((a) => a < portada.width), portada.width] : [];
// La portada nunca se estira más allá de su tamaño real (se vería borrosa) y,
// cuando va junto al texto, tampoco se sale por debajo de la pantalla.
const medidas = portada
  ? `--proporcion: ${(portada.width / portada.height).toFixed(4)}; --ancho-natural: ${portada.format === 'svg' ? '100vw' : `${portada.width}px`}`
  : undefined;
---

<section class="portada" id="inicio" aria-labelledby="titulo-sitio">
  <div class="contenedor portada__rejilla">
    <div class="portada__texto">
      <p class="etiqueta">{sitio.autor} · Novela</p>
      <h1 id="titulo-sitio">{sitio.titulo}</h1>
      <p class="portada__lema">{sitio.lema}</p>
      {
        sitio.gancho.length > 0 && (
          <p class="portada__gancho">
            {sitio.gancho.map((linea) => (
              <span>{linea} </span>
            ))}
          </p>
        )
      }
      <div class="portada__acciones">
        <a class="boton boton--primario" href={seccion('conseguir')}>Dónde conseguirla</a>
        <a class="enlace" href={seccion('novela')}>
          Conoce la historia
          <Flecha tipo="abajo" />
        </a>
      </div>
      <p class="portada__ficha">
        <span>{sitio.genero}</span>
        <span class="portada__punto" aria-hidden="true"> · </span>
        <span>{sitio.editorial}</span>
      </p>
    </div>

    {
      portada && (
        <figure class="portada__imagen" style={medidas}>
          <Image
            src={portada}
            alt={sitio.portada_descripcion}
            widths={anchos}
            sizes="(min-width: 42rem) 27rem, 80vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }
  </div>
</section>

<style>
  .portada {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) clamp(3.5rem, 2rem + 6vw, 7rem);
  }

  .portada__rejilla {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .portada__texto {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    /* el título se mide contra el ancho de esta columna (unidades cqi) */
    container-type: inline-size;
  }

  h1 {
    font-size: var(--t-h1);
    /* tan grande como quepa en la columna, sin comerse una pantalla baja */
    font-size: clamp(3.5rem, min(26cqi, 22svh), 9rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: 0.035em;
    text-transform: uppercase;
    /* compensa el interletrado para alinear ópticamente con el resto */
    margin-left: -0.03em;
  }

  .portada__lema {
    max-width: 24ch;
    font-family: var(--fuente-titulos);
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.5rem);
    /* en teléfonos crece hasta que su primera línea llena la columna */
    font-size: clamp(1.75rem, 10.8cqi, 2.5rem);
    font-style: italic;
    line-height: 1.15;
    color: var(--acento);
    text-wrap: balance;
  }

  .portada__gancho {
    max-width: 34rem;
    color: var(--texto-suave);
  }

  /* Si género y editorial no caben en una línea, van una bajo la otra
     en vez de dejar el punto colgando al final */
  @container (max-width: 25rem) {
    .portada__ficha span {
      display: block;
    }

    .portada__ficha .portada__punto {
      display: none;
    }
  }

  /* una frase por línea solo cuando cada una cabe entera */
  @container (min-width: 30rem) {
    .portada__gancho span {
      display: block;
    }
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 0.75rem;
  }

  .portada__ficha {
    margin-top: 1.5rem;
    font-size: var(--t-etiqueta);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .portada__imagen {
    position: relative;
    justify-self: center;
    width: min(80%, 27rem, var(--ancho-natural, 27rem));
  }

  /* halo cálido detrás del libro */
  .portada__imagen::before {
    content: '';
    position: absolute;
    inset: -18%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(203 182 143 / 0.16), transparent 72%);
  }

  .portada__imagen img {
    width: 100%;
    border-radius: var(--radio);
    box-shadow:
      0 0 0 1px var(--linea),
      0 2rem 3.5rem rgb(0 0 0 / 0.6);
  }

  /* Tableta y teléfono horizontal: texto y libro lado a lado */
  @media (min-width: 42rem) {
    .portada__rejilla {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .portada__imagen {
      justify-self: end;
      width: min(100%, 27rem, var(--ancho-natural, 27rem));
      width: min(
        100%,
        27rem,
        var(--ancho-natural, 27rem),
        max(11rem, (100svh - var(--alto-cabecera) - 9rem) * var(--proporcion, 0.65))
      );
    }
  }

  @media (min-width: 60rem) {
    .portada__rejilla {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    }
  }

  /* Pantallas muy bajas (teléfono horizontal): todo más compacto */
  @media (max-height: 30rem) and (min-width: 42rem) {
    .portada {
      padding-block: 1.5rem 2.5rem;
    }

    .portada__rejilla {
      align-items: start;
    }

    .portada__texto {
      gap: 0.75rem;
    }

    .portada__lema {
      font-size: 1.5rem;
    }

    .portada__acciones {
      margin-top: 0.25rem;
    }

    .portada__ficha {
      margin-top: 0.5rem;
    }
  }
</style>
