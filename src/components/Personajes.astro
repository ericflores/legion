---
import { Image, getImage } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { imagen } from '../lib/imagenes';
import Seccion from './Seccion.astro';

interface Props {
  etiqueta: string;
  titular: string;
}
const { etiqueta, titular } = Astro.props;

const personajes = (await getCollection('personajes')).sort(
  (a, b) => a.data.orden - b.data.orden || a.data.nombre.localeCompare(b.data.nombre, 'es'),
);
const fichas = await Promise.all(
  personajes.map(async (p) => {
    const foto = imagen(p.data.foto);
    // la versión grande, la que se abre al tocar la cara: nunca más ancha que el original
    const grande = foto && (await getImage({ src: foto, width: Math.min(foto.width, 800), format: 'webp' }));
    return { ...p.data, foto, grande, Descripcion: (await render(p)).Content };
  }),
);
---

{
  fichas.length > 0 && (
    <Seccion id="personajes" etiqueta={etiqueta} titular={titular} disposicion="apilada">
      <ul class="personajes" role="list">
        {fichas.map((p) => (
          <li class="personaje">
            <div class="personaje__cabeza">
              {p.foto && p.grande && (
                <a
                  class="personaje__cara"
                  href={p.grande.src}
                  data-cara
                  data-nombre={p.nombre}
                  data-rol={p.rol ?? ''}
                  data-ancho={p.grande.attributes.width}
                  data-alto={p.grande.attributes.height}
                >
                  <Image src={p.foto} alt="" width={160} height={160} fit="cover" />
                  <span class="solo-lectores">Ver más grande el retrato de {p.nombre}</span>
                </a>
              )}
              <div>
                <h3>{p.nombre}</h3>
                {p.rol && <p class="personaje__rol">{p.rol}</p>}
              </div>
            </div>
            <div class="personaje__texto">
              <p.Descripcion />
            </div>
          </li>
        ))}
      </ul>

      {/* El retrato en grande. Sin JavaScript, la cara es un enlace normal a la imagen. */}
      <dialog class="retrato" data-retrato aria-labelledby="retrato-nombre">
        <figure>
          <img alt="" data-retrato-imagen />
          <figcaption>
            <span class="retrato__nombre" id="retrato-nombre" data-retrato-nombre />
            <span class="retrato__rol" data-retrato-rol />
          </figcaption>
        </figure>
        <form method="dialog">
          <button class="retrato__cerrar" type="submit">Cerrar</button>
        </form>
      </dialog>
    </Seccion>
  )
}

<script>
  const retrato = document.querySelector<HTMLDialogElement>('[data-retrato]');

  if (retrato && typeof retrato.showModal === 'function') {
    const foto = retrato.querySelector<HTMLImageElement>('[data-retrato-imagen]')!;
    const nombre = retrato.querySelector<HTMLElement>('[data-retrato-nombre]')!;
    const rol = retrato.querySelector<HTMLElement>('[data-retrato-rol]')!;

    document.addEventListener('click', (evento) => {
      const cara = (evento.target as HTMLElement).closest<HTMLAnchorElement>('[data-cara]');
      if (!cara) return;
      // con Ctrl, Cmd o el botón central el enlace abre la imagen aparte, como siempre
      if (evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.button !== 0) return;
      evento.preventDefault();
      foto.width = Number(cara.dataset.ancho);
      foto.height = Number(cara.dataset.alto);
      foto.src = cara.href;
      foto.alt = `Retrato de ${cara.dataset.nombre}`;
      nombre.textContent = cara.dataset.nombre ?? '';
      rol.textContent = cara.dataset.rol ?? '';
      retrato.showModal();
    });

    // tocar fuera del retrato (o el propio retrato) lo cierra
    retrato.addEventListener('click', (evento) => {
      if (!(evento.target as HTMLElement).closest('button')) retrato.close();
    });
  }
</script>

<style>
  .personajes {
    display: grid;
    gap: 1px;
    padding: 1px;
  }

  .personaje {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    /* contorno de 1px que se solapa con el de la ficha vecina */
    box-shadow: 0 0 0 1px var(--linea-solida);
  }

  .personaje__cabeza {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  /* La cara: pequeña junto al nombre; al tocarla se abre en grande */
  .personaje__cara {
    flex: none;
    display: block;
    width: 4.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--lomo);
    cursor: zoom-in;
    transition:
      box-shadow 0.2s,
      opacity 0.2s;
  }

  .personaje__cara:hover {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--acento);
  }

  .personaje__cara img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .personaje__rol {
    margin-top: 0.25rem;
    font-size: var(--t-etiqueta);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--acento);
  }

  .personaje__texto {
    margin-top: 0.5rem;
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  /* ---- El retrato en grande ---- */

  .retrato {
    width: min(100vw - 2rem, 30rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    overflow: auto;
    border: 1px solid var(--lomo);
    background: var(--superficie);
    color: var(--texto);
    cursor: zoom-out;
  }

  .retrato::backdrop {
    background: rgb(8 8 10 / 0.86);
  }

  .retrato img {
    display: block;
    width: 100%;
    height: auto;
    background: var(--superficie-alta);
  }

  .retrato figcaption {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 1.25rem 0.25rem;
  }

  .retrato__nombre {
    font-family: var(--fuente-titulos);
    font-size: var(--t-h3);
    font-weight: 600;
    line-height: 1.2;
  }

  .retrato__rol {
    font-size: var(--t-etiqueta);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--acento);
  }

  .retrato form {
    padding: 0.5rem 1.25rem 1.1rem;
  }

  .retrato__cerrar {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: var(--t-pequeno);
    font-weight: 600;
    color: var(--acento);
    text-decoration: underline;
    text-decoration-color: rgb(203 182 143 / 0.45);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  @media (min-width: 42rem) {
    .personajes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* el protagonista (primero en orden) ocupa la fila completa */
    .personaje:first-child {
      grid-column: 1 / -1;
      background: var(--superficie);
    }

    .personaje:first-child h3 {
      font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem);
    }

    .personaje:first-child .personaje__cara {
      width: 6rem;
    }

    .personaje:first-child .personaje__texto {
      max-width: var(--lectura);
      font-size: var(--t-texto);
    }
  }

  @media (min-width: 68rem) {
    .personajes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
