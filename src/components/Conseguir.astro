---
import { seccion, unico } from '../lib/sitio';
import EnlaceExterno from './EnlaceExterno.astro';
import Seccion from './Seccion.astro';

const { data } = await unico('librerias');
---

<Seccion id="conseguir" etiqueta={data.etiqueta} titular={data.titular}>
  {
    data.lista.length > 0 && (
      <ul class="librerias" role="list">
        {data.lista.map((l) => (
          <li class="libreria">
            <h3>{l.nombre}</h3>
            {l.lugar && <p class="libreria__lugar">{l.lugar}</p>}
            <span class="libreria__accion">
              {l.enlace ? (
                <EnlaceExterno href={l.enlace}>
                  Comprar en línea<span class="solo-lectores"> en {l.nombre}</span>
                </EnlaceExterno>
              ) : (
                <span class="libreria__tienda">En tienda</span>
              )}
            </span>
          </li>
        ))}
      </ul>
    )
  }
  <p class="librerias__nota">
    {data.nota}{' '}
    ¿No la encuentras cerca?{' '}
    <a href={seccion('contacto')} data-motivo="Conseguir un ejemplar">Pídesela al autor</a>.
  </p>
</Seccion>

<style>
  .librerias {
    border-top: 1px solid var(--linea-fuerte);
  }

  /* En columnas estrechas: el nombre arriba, y debajo el lugar a la
     izquierda y la acción a la derecha, siempre en el mismo sitio. */
  .libreria {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'nombre nombre'
      'lugar accion';
    align-items: center;
    column-gap: 1.5rem;
    padding-block: 1.1rem 0.6rem;
    border-bottom: 1px solid var(--linea);
  }

  .libreria h3 {
    grid-area: nombre;
  }

  .libreria__lugar {
    grid-area: lugar;
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .libreria__accion {
    grid-area: accion;
    display: inline-flex;
    align-items: center;
    justify-self: end;
    min-height: 2.75rem;
  }

  /* Con espacio de sobra: nombre y lugar a la izquierda, acción centrada
     a la derecha, todo en una fila. */
  @container (min-width: 30rem) {
    .libreria {
      grid-template-areas:
        'nombre accion'
        'lugar accion';
      padding-block: 1.1rem;
    }
  }

  .libreria__tienda {
    font-size: var(--t-pequeno);
    font-weight: 500;
    color: var(--texto-suave);
  }

  .librerias__nota {
    max-width: var(--lectura);
    margin-top: 1.75rem;
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  .librerias__nota a {
    font-weight: 600;
  }
</style>
