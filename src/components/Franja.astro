---
// Franja de ancho completo para una frase que da respiro entre secciones.
interface Props {
  titular: string;
  texto?: string;
}
const { titular, texto } = Astro.props;
---

<aside class="franja">
  <div class="contenedor">
    <p class="franja__titular">{titular}</p>
    {texto && <p class="franja__texto">{texto}</p>}
    <slot />
  </div>
</aside>

<style>
  .franja {
    padding-block: clamp(3.5rem, 2rem + 6vw, 6.5rem);
    border-top: 1px solid var(--linea);
    background: var(--superficie);
    text-align: center;
  }

  .franja .contenedor {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
  }

  .franja__titular {
    max-width: 22ch;
    font-family: var(--fuente-titulos);
    font-size: clamp(2rem, 1.2rem + 3.6vw, 3.75rem);
    font-style: italic;
    font-weight: 500;
    line-height: 1.08;
    text-wrap: balance;
  }

  .franja__texto {
    max-width: 46ch;
    color: var(--texto-suave);
    text-wrap: balance;
  }
</style>
